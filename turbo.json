{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!types/**",
        "$TURBO_ROOT$/.node-version",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/ops/biome/**",
        "$TURBO_ROOT$/ops/helpers/nodeEngine.js",
        "$TURBO_ROOT$/ops/scripts/esbuild.js",
        "$TURBO_ROOT$/ops/typedefs/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["dist/**", "types/**"]
    },
    "codsen#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "csv-sort-cli#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "email-all-chars-within-ascii-cli#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "generate-atomic-css-cli#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "js-row-num-cli#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "json-comb#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "json-sort-cli#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "lerna-clean-changelogs-cli#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "update-versions#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "@codsen/data#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "$TURBO_ROOT$/.node-version",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!types/**",
        "$TURBO_ROOT$/ops/typedefs/common.ts",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": []
    },
    "unit": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "outputs": [],
      "cache": false
    },
    "devtest": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    },
    "lect": {
      "outputs": [],
      "cache": false
    },
    "lect:check": {
      "outputs": [],
      "cache": false
    },
    "prettier:format": {
      "outputs": [],
      "cache": false
    },
    "perf": {
      "dependsOn": ["build", "json-comb-core#build"],
      "outputs": [],
      "cache": false
    },
    "examples": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    },
    "prep": {
      "dependsOn": ["unit", "examples", "lint"]
    }
  }
}
