{
  "html-void-br": "<br>",
  "html-void-wbr": "one<wbr>two",
  "html-unquoted-solidus": "<img alt=\"\" src=x/>",
  "html-separated-solidus": "<img alt=\"\" src=x />",
  "html-double-quoted-greater-than": "<p title=\"a > b\">text</p>",
  "html-single-quoted-greater-than": "<p title='a > b'>text</p>",
  "html-boolean-attribute": "<input disabled>",
  "html-ascii-case": "<DIV TITLE=\"X\">Text</DIV>",
  "html-named-references": "<p>&copy; &amp; &NotEqualTilde;</p>",
  "html-numeric-recovery": "<p>&#65; &#x1F680; &#0;</p>",
  "html-reference-context": "<p title=\"&notit; &amp;\">&notit;</p>",
  "html-textarea-rcdata": "<textarea><b>&amp;</b></textarea>",
  "html-title-rcdata": "<title>one &amp; two</title>",
  "html-comments": "<p>A<!-- note -->B</p>",
  "html-doctype": "<!doctype html><p>text</p>",
  "html-optional-end-tags": "<ul><li>one<li>two</ul>",
  "html-foreign-self-close": "<svg><path d=\"M0 0\" /></svg>",
  "html-unquoted-class-solidus": "<style>.used\\/{color:red}</style><img alt=\"\" class=used/>",
  "css-comments": "<style>.used{/* note */color:red}.gone{color:blue}</style><p class=\"used\">text</p>",
  "css-hex-escape": "<style>.\\31 23{color:red}</style><p class=\"123\">text</p>",
  "css-escaped-punctuation": "<style>.a\\+b{color:red}</style><p class=\"a+b\">text</p>",
  "css-string-delimiters": "<style>.used::before{content:\"a; } /* b */\"}</style><p class=\"used\">text</p>",
  "css-url-delimiters": "<style>.used{background:url(\"https://example.test/a;b#c\")}</style><p class=\"used\">text</p>",
  "css-attribute-selector": "<style>.used[data-x=\"a,b\"]{color:red}</style><p class=\"used\" data-x=\"a,b\">text</p>",
  "css-is-selector": "<style>:is(.used,.gone){color:red}</style><p class=\"used\">text</p>",
  "css-not-selector": "<style>.used:not(.gone){color:red}</style><p class=\"used\">text</p>",
  "css-nested-conditional": "<style>@media screen{@supports (display:grid){.used{display:grid}.gone{color:red}}}</style><p class=\"used\">text</p>",
  "css-custom-properties": "<style>:root{--accent:red;--tokens:a  b}.used{color:var(--accent)}</style><p class=\"used\">text</p>",
  "css-nesting": "<style>.used{color:red;& .child{color:blue}}</style><div class=\"used\"><span class=\"child\">text</span></div>",
  "css-font-face": "<style>@font-face{font-family:\"A; B\";src:url(\"font.woff2\")}.used{font-family:\"A; B\"}</style><p class=\"used\">text</p>",
  "js-template-lines": "<script>const x = `one\n\n  two`;</script><p>text</p>",
  "js-regexp": "<script>const pattern = /<[a-z]+>/gi;</script><p>text</p>",
  "js-line-comment": "<script>// <b>literal</b>\nconst x = 1;</script><p>text</p>",
  "js-html-like-string": "<script>const x = \"<!-- literal -->\";</script><p>text</p>",
  "js-modern-operators": "<script type=\"module\">const x = data?.value ?? \"fallback\";</script><p>text</p>",
  "js-end-tag-prefix": "<script>const x = \"</scriptx>\";</script><p>text</p>"
}
