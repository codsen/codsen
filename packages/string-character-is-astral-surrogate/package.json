    "dts": "rollup -c && npm run prettier:format",
    "examples": "node '../../ops/scripts/run-examples.js'",
    "lect": "node '../../ops/lect/lect.js' && npm run prettier:format",
    "letspublish": "npm publish --provenance",
    "lint": "biome lint --error-on-warnings .",
