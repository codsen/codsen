{
  "name": "generate-atomic-css-cli",
  "version": "4.1.3",
  "description": "Generates and updates all HTML templates' atomic CSS",
  "keywords": [
    "atomic",
    "cli",
    "cli-app",
    "create",
    "css",
    "development",
    "email",
    "generate",
    "mailing",
    "marketing",
    "refresh",
    "render",
    "template",
    "tool",
    "update"
  ],
  "homepage": "https://codsen.com/os/generate-atomic-css-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codsen/codsen.git",
    "directory": "packages/generate-atomic-css-cli"
  },
  "license": "MIT",
  "author": {
    "name": "Roy Revelt",
    "email": "roy@codsen.com",
    "url": "https://codsen.com"
  },
  "type": "module",
  "bin": {
    "gac": "cli.js"
  },
  "scripts": {
    "build": "exit 0",
    "dev": "exit 0",
    "devtest": "npm run test",
    "dts": "exit 0",
    "examples": "exit 0",
    "lect": "node '../../ops/lect/lect.js' && npm run prettier:format",
    "letspublish": "npm publish --provenance",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "perf": "exit 0",
    "prep": "echo 'ready'",
    "prettier": "biome format",
    "prettier:format": "biome format --write .",
    "pretest": "exit 0",
    "test": "c8 npm run unit && npm run lint",
    "unit": "uvu test"
  },
  "c8": {
    "all": true,
    "check-coverage": true,
    "exclude": ["**/test/**/*.*"],
    "lines": 84
  },
  "lect": {
    "licence": {
      "extras": [""]
    },
    "various": {}
  },
  "dependencies": {
    "codsen-glob": "^1.0.0",
    "codsen-utils": "^1.7.3",
    "generate-atomic-css": "^3.1.3",
    "p-reduce": "^3.0.0",
    "update-notifier": "^7.3.1",
    "write-file-atomic": "^6.0.0"
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
