{
  "profiles": {
    "default": {
      "check-coverage": true,
      "exclude": ["**/test/**/*.*"],
      "lines": 100
    },
    "cli": {
      "all": true,
      "exclude": ["**/test/**/*.*", "cli-update-notifier.js"]
    },
    "rollup": {
      "all": true,
      "include": ["dist/*.esm.js"]
    },
    "full": {
      "branches": 100,
      "functions": 100,
      "statements": 100
    }
  },
  "fullCoveragePackages": [
    "array-includes-with-glob",
    "array-pull-all-with-glob",
    "arrayiffy-if-string",
    "ast-compare",
    "ast-contains-only-empty-space",
    "ast-is-empty",
    "ast-monkey",
    "ast-monkey-util",
    "codsen-glob",
    "codsen-utils",
    "csv-sort-cli",
    "generate-atomic-css-cli",
    "js-row-num-cli",
    "json-sort-cli",
    "lerna-clean-changelogs-cli",
    "object-boolean-combinations",
    "object-delete-key",
    "ranges-apply",
    "ranges-merge",
    "ranges-sort",
    "regex-empty-conditional-comments",
    "remark-typography",
    "string-character-is-astral-surrogate",
    "string-collapse-leading-whitespace",
    "string-extract-class-names",
    "string-range-expander",
    "string-trim-spaces-only",
    "test-mixer",
    "update-versions",
    "util-array-object-or-both",
    "util-nonempty"
  ],
  "packageOverrides": {
    "codsen-glob": {
      "reporter": ["text", "text-summary"]
    }
  },
  "workspaceExemptions": {
    "@codsen/data": {
      "reason": "This generated aggregate-data workspace is validated by ci:verify:data and has no hand-authored runtime behaviour to unit test.",
      "followUp": "Add package coverage and remove this exemption if hand-authored runtime behaviour is introduced."
    }
  },
  "waivers": {}
}
