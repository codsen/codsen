{
  "name": "@codsen/data",
  "version": "0.5.1",
  "description": "extracted data from Codsen monorepo",
  "license": "MIT",
  "author": {
    "name": "Roy Revelt",
    "email": "roy@codsen.com",
    "url": "https://codsen.com"
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=18.20.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codsen/codsen.git",
    "directory": "data"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node --input-type=commonjs -e \"require('node:fs').rmSync('./dist',{recursive:true,force:true})\" && tsc --project tsconfig.json",
    "test": "echo 'no tests'",
    "dev": "exit 0",
    "devtest": "exit 0",
    "dts": "exit 0",
    "examples": "exit 0",
    "lect": "exit 0",
    "lint": "npm run typecheck",
    "perf": "exit 0",
    "prep": "exit 0",
    "prettier": "exit 0",
    "prettier:format": "exit 0",
    "pretest": "exit 0",
    "typecheck": "tsc --noEmit --pretty false --project tsconfig.json",
    "unit": "exit 0"
  }
}
