{
  "name": "codsen-mono",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": {
    "email": "roy@codsen.com",
    "name": "Roy Revelt",
    "url": "https://codsen.com"
  },
  "type": "module",
  "workspaces": ["packages/*", "data/"],
  "scripts": {
    "prebuild": "node ./ops/scripts/verify-root-toolchain.js && npm run ci:verify:package-kinds",
    "build": "turbo run build",
    "build:packages": "npm run build -- '--filter=./packages/**'",
    "cache:prune": "node ./ops/scripts/prune-turbo-cache.js",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "ci:audit:production": "node ./ops/scripts/audit-production-dependencies.js",
    "ci:build:root-readme": "node ./ops/scripts/generate-readme.js",
    "ci:fix:test-numbering": "node ./ops/scripts/fix-unit-test-numbering.js",
    "ci:generate:changelogs": "npm run build -- '--filter=lerna-clean-changelogs' '--filter=remark-conventional-commit-changelog-timeline' '--filter=remark-typography' && npm run perf:changelogs && node ./ops/scripts/generate-changelogs.js",
    "ci:generate:info": "npm run build:packages && node ./ops/scripts/generate-info.js",
    "ci:generate:npmrc": "node ./ops/scripts/generate-npmrc.js",
    "ci:generate:package-kind-config": "node ./ops/scripts/generate-package-kind-config.js",
    "ci:lerna:version": "lerna version --no-push --no-git-tag-version --conventional-commits --no-commit-hooks --sync-workspace-lock --yes",
    "ci:pack:check": "npm pack --dry-run --json --workspaces --ignore-scripts",
    "ci:release": "node ./ops/scripts/npm-release.js",
    "ci:verify:browser-iifes": "node ./ops/scripts/verify-browser-iifes.js",
    "ci:verify:coverage-policy": "node ./ops/scripts/verify-coverage-policy.js",
    "ci:verify:dependency-security-policy": "node ./ops/scripts/audit-production-dependencies.js --check-policy",
    "ci:verify:changelogs": "npm run build -- '--filter=lerna-clean-changelogs' '--filter=remark-conventional-commit-changelog-timeline' '--filter=remark-typography' && npm run perf:changelogs:check && node ./ops/scripts/generate-changelogs.js --check",
    "ci:verify:info": "npm run build:packages && node ./ops/scripts/generate-info.js --check",
    "ci:verify:node-compatibility": "node ./ops/scripts/verify-node-compatibility.js",
    "ci:verify:npmrc": "node ./ops/scripts/generate-npmrc.js --check",
    "ci:verify:package-kinds": "node ./ops/scripts/verify-package-kinds.js",
    "ci:verify:root-readme": "node ./ops/scripts/generate-readme.js --check",
    "ci:verify:root-toolchain": "node ./ops/scripts/verify-root-toolchain.js",
    "ci:verify:test-numbering": "node ./ops/scripts/verify-unit-test-numbering.js",
    "ci:verify:data": "node ./ops/scripts/verify-data.js",
    "ci:verify:debug-log-production-cost": "node ./ops/scripts/verify-dev-only-impure-locals.js",
    "lernacleanchangelog": "node packages/lerna-clean-changelogs-cli/cli.js '**' --extras",
    "dev": "turbo run dev --parallel",
    "email-client-hacks:check": "node ./ops/scripts/email-client-hacks.js check",
    "email-client-hacks:project": "node ./ops/scripts/email-client-hacks.js project",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "graph": "turbo run build --graph=deps-graph.html",
    "fix": "npm run ci:fix:test-numbering && npm run check:fix && npm run generate",
    "generate": "npm run lect && npm run ci:generate:changelogs && npm run ci:generate:info && npm run stats:charts && npm run ci:build:root-readme",
    "house": "npm run fix",
    "lect": "npm run ci:generate:npmrc && npm run ci:generate:package-kind-config && node ./ops/lect/root.js && turbo run lect",
    "lect:check": "npm run ci:verify:npmrc && npm run ci:verify:package-kinds && node ./ops/lect/root.js --check && turbo run lect:check",
    "lerna": "lerna",
    "lint": "npm run check && npm run typecheck && npm run lint:markdown",
    "lint:fix": "npm run check:fix && npm run typecheck && npm run lint:markdown",
    "lint:markdown": "remark --frail \"AGENTS.md\" \".agents/**/*.md\" \".github/**/*.md\" \"packages/*/AGENTS.md\"",
    "nuke": "git clean -fdx",
    "perf": "turbo run perf --concurrency=1 --continue=dependencies-successful",
    "perf:check": "node ./ops/scripts/check-perf.js",
    "perf:changelogs": "node ./ops/scripts/sync-perf-changelogs.js",
    "perf:changelogs:check": "node ./ops/scripts/sync-perf-changelogs.js --check",
    "preperf": "npm run build:packages",
    "prep": "turbo run prep",
    "prepare": "git config core.hooksPath ops/git-hooks || true",
    "prepush": "npm run fix",
    "prettier": "npm run check",
    "prettier:format": "npm run check:fix",
    "preview:update-notifier": "node ./ops/scripts/preview-cli-update-notifier.js",
    "standards:check": "node ./ops/scripts/standards.js check",
    "standards:known-failures": "node ./ops/scripts/standards.js known-failures",
    "standards:project": "node ./ops/scripts/standards.js project",
    "standards:refresh": "node ./ops/scripts/standards.js refresh",
    "standards:report": "node ./ops/scripts/standards.js report",
    "stats:charts": "node ./ops/scripts/generate-statistics-charts.js",
    "stats:charts:check": "node ./ops/scripts/generate-statistics-charts.js --check",
    "stats:check": "node ./ops/scripts/verify-npm-downloads.js",
    "stats:export": "node ./ops/scripts/export-npm-downloads.js",
    "stats:refresh": "node ./ops/scripts/refresh-npm-downloads.js",
    "test": "npm run verify && npm run test:compatibility && npm run test:quality",
    "test:compatibility": "node ./ops/scripts/test-node-compatibility.js",
    "coverage:workspaces": "node ./ops/scripts/coverage-workspaces.js",
    "test:coverage": "npm run build:packages && turbo run '//#coverage:workspaces'",
    "test:examples-runner": "uvu ops/helpers runExamplesCli",
    "test:ops-helpers": "uvu ops/helpers",
    "test:quality": "turbo run devtest",
    "ts": "deno run --allow-read --allow-run --allow-write --allow-net",
    "turbo": "turbo",
    "typecheck": "node ./ops/scripts/typecheck-workspaces.js",
    "unit": "npm run test:ops-helpers && turbo run unit",
    "verify": "npm run ci:verify:root-toolchain && npm run ci:verify:package-kinds && npm run ci:verify:debug-log-production-cost && npm run ci:verify:test-numbering && npm run ci:verify:dependency-security-policy && npm run standards:check && npm run email-client-hacks:check && npm run check && npm run lint:markdown && npm run stats:check && npm run test:ops-helpers && npm run ci:verify:coverage-policy && npm run ci:verify:node-compatibility && npm run verify:generated && npm run ci:verify:browser-iifes && npm run typecheck",
    "verify:generated": "npm run lect:check && npm run ci:verify:info && npm run stats:charts:check && npm run ci:verify:changelogs && npm run ci:verify:root-readme && npm run build -- '--filter=./data/**' && npm run ci:verify:data",
    "wipe": "rm package-lock.json || true && rm -rf node_modules && git clean -fXd && npm i"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@lerna-lite/cli": "^5.6.1",
    "@lerna-lite/version": "^5.6.1",
    "@octokit/plugin-enterprise-rest": "file:./ops/stubs/octokit-plugin-enterprise-rest",
    "@rollup/plugin-json": "^6.1.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^25.9.5",
    "@types/object-path": "^0.11.4",
    "benchmark": "^2.1.4",
    "c8": "^12.0.0",
    "dequal": "^2.0.3",
    "esbuild": "^0.28.2",
    "execa": "^9.6.1",
    "hast-util-raw": "^9.1.0",
    "lodash.partition": "^4.6.0",
    "object-path": "^0.11.8",
    "perf-ref": "^1.0.5",
    "rehype-format": "^5.0.1",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-preset-lint-recommended": "^7.0.1",
    "remark-rehype": "^11.1.2",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "semver-regex": "^4.0.5",
    "simple-git": "^3.36.0",
    "sort-package-json": "^4.0.0",
    "tempy": "^3.2.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-builder": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "uvu": "^0.5.6"
  },
  "overrides": {
    "conventional-changelog": "8.1.3"
  },
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
