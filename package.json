{
  "name": "codsen-mono",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": {
    "email": "roy@codsen.com",
    "name": "Roy Revelt",
    "url": "https://codsen.com"
  },
  "type": "module",
  "workspaces": ["packages/*", "data/"],
  "scripts": {
    "build": "turbo run build",
    "ci:build:root-readme": "node ./ops/scripts/generate-readme.js",
    "ci:generate:changelogs": "npm run lernacleanchangelog && node ./ops/scripts/generate-changelogs.js",
    "ci:generate:info": "node ./ops/scripts/generate-info.js",
    "ci:lerna:version": "lerna version --no-push --no-git-tag-version --conventional-commits --no-commit-hooks --yes",
    "ci:pack:check": "npm pack --dry-run --json --workspaces --ignore-scripts",
    "ci:release": "node ./ops/scripts/npm-release.js",
    "ci:verify:data": "node ./ops/scripts/verify-data.js",
    "lernacleanchangelog": "lernacleanchangelog '**' --extras",
    "cm": "git-cz -n",
    "dev": "turbo run dev --parallel",
    "format": "biome format --write .",
    "graph": "turbo run build --graph=deps-graph.html",
    "house": "npm run lernacleanchangelog && npm run prettier && uvu ops/helpers && npm run update:projectReferences && npm run ci:generate:info && npm run ci:generate:changelogs && npm run ci:build:root-readme",
    "lect": "turbo run lect",
    "lerna": "lerna",
    "lint": "turbo run lint",
    "nuke": "git clean -fdx",
    "perf": "turbo run perf",
    "prep": "turbo run prep",
    "prettier": "biome check --write .",
    "test": "npm run house && npm run lect && npm run build && turbo run devtest && npm run perf",
    "test:projectReferences": "workspaces-to-typescript-project-references --includesRoot --check",
    "ts": "deno run --allow-read --allow-run --allow-write --allow-net",
    "turbo": "turbo",
    "unit": "npm run house && turbo run unit",
    "update:projectReferences": "workspaces-to-typescript-project-references --includesRoot",
    "wipe": "rm package-lock.json || true && rm -rf node_modules && git clean -fXd && npm i",
    "knip": "knip"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@lerna-lite/cli": "^5.4.2",
    "@lerna-lite/version": "^5.4.2",
    "@monorepo-utils/workspaces-to-typescript-project-references": "^2.11.0",
    "@rollup/plugin-json": "^6.1.0",
    "@sindresorhus/merge-streams": "^4.0.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.9.3",
    "@types/object-path": "^0.11.4",
    "array-pull-all-with-glob": "^7.1.3",
    "benchmark": "^2.1.4",
    "c8": "^11.0.0",
    "codsen-utils": "^1.7.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dequal": "^2.0.3",
    "detergent": "^9.3.3",
    "edit-package-json": "^0.9.3",
    "esbuild": "^0.28.1",
    "esbuild-register": "^3.6.0",
    "execa": "^9.6.1",
    "hast-util-raw": "^9.1.0",
    "json-comb-core": "^8.1.3",
    "knip": "^6.17.1",
    "lerna-clean-changelogs-cli": "^4.1.3",
    "lodash.camelcase": "^4.3.0",
    "lodash.chunk": "^4.2.0",
    "lodash.intersection": "^4.4.0",
    "lodash.partition": "^4.6.0",
    "object-delete-key": "^4.1.3",
    "object-path": "^0.11.8",
    "perf-ref": "^1.0.5",
    "rehype-format": "^5.0.1",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-conventional-commit-changelog-timeline": "^3.2.3",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-typography": "^0.7.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.0",
    "rollup-plugin-dts": "^6.4.1",
    "semver-regex": "^4.0.5",
    "simple-git": "^3.36.0",
    "sort-package-json": "^4.0.0",
    "tempy": "^3.2.0",
    "turbo": "^2.9.18",
    "typescript": "^6.0.0",
    "unicorn-magic": "^0.4.0",
    "unified": "^11.0.5",
    "unist-builder": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "uvu": "^0.5.6",
    "write-file-atomic": "^8.0.0"
  },
  "overrides": {
    "conventional-changelog": "8.1.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  },
  "packageManager": "npm@11.16.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
