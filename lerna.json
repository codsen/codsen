{
  "npmClient": "npm",
  "command": {
    "version": {
      "commitHooks": false,
      "conventionalCommits": true,
      "forcePublish": ["@codsen/data"],
      "gitTagVersion": false,
      "message": "chore(release): publish",
      "push": false
    }
  },
  "ignoreChanges": [
    "**/node_modules/**",
    "**/.npmignore",
    "**/perf/**",
    "**/*.md"
  ],
  "packages": ["packages/*", "data"],
  "version": "independent",
  "$schema": "node_modules/@lerna-lite/cli/schemas/lerna-schema.json"
}
